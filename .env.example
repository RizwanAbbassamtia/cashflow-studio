# Copy this file to .env on your own PC and fill in your keys.
# .env is ignored by git. Never commit a real key.

# --- LLM (script, titles, storyboard, QA) ---
# Leave empty if the pipeline is driven from Claude Code instead of the API.
ANTHROPIC_API_KEY=

# --- Voice (use the variable named on the channel's Voice tab) ---
FISH_AUDIO_API_KEY=
MINIMAX_API_KEY=
CARTESIA_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- Images (use the variable named on the channel's Images tab) ---
GEMINI_API_KEY=
FAL_KEY=
REPLICATE_API_TOKEN=
IDEOGRAM_API_KEY=
OPENAI_API_KEY=

# --- Local paths (defaults, can be changed per channel in the master sheet) ---
CFS_PROJECTS_DIR=D:\CashflowStudio\projects
CFS_EXPORTS_DIR=D:\CashflowStudio\exports
FFMPEG_PATH=ffmpeg
